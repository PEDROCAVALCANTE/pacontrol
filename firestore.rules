rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Since this is a single workspace app, any authenticated user can read and write data.
    // If you plan to have multiple users with different data, you should add a `userId` field
    // to all your documents and check it here (e.g., `resource.data.userId == request.auth.uid`).

    match /clients/{clientId} {
      allow read, write: if isSignedIn();
    }

    match /subscriptions/{subscriptionId} {
      allow read, write: if isSignedIn();
    }

    match /expenses/{expenseId} {
      allow read, write: if isSignedIn();
    }
    
    // Catch-all deny for any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
